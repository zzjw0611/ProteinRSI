{
  "name": "structure_compare",
  "capability": "structure.compare",
  "description": "Kabsch CA RMSD for explicitly matched equal-length chains. No automatic alignment.",
  "limitations": "",
  "engine": "utilities",
  "task_kinds": [
    "variant_design",
    "variant_ranking",
    "binder_design",
    "affinity_prediction"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "reference_ref": {
        "type": "string",
        "pattern": "^artifact:[0-9a-f]{64}\\.(pdb|cif|a3m|fasta|json)$"
      },
      "reference_chain": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]$"
      },
      "prediction_ref": {
        "type": "string",
        "pattern": "^artifact:[0-9a-f]{64}\\.(pdb|cif|a3m|fasta|json)$"
      },
      "prediction_chain": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]$"
      }
    },
    "required": [
      "reference_ref",
      "reference_chain",
      "prediction_ref",
      "prediction_chain"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "evidence_kind": {
        "type": "string"
      },
      "warning": {
        "type": "string"
      },
      "ca_rmsd_angstrom": {
        "type": "number"
      },
      "matched_residues": {
        "type": "integer",
        "minimum": 3
      },
      "mapping": {
        "type": "string"
      }
    },
    "required": [
      "evidence_kind",
      "ca_rmsd_angstrom",
      "matched_residues",
      "mapping",
      "warning"
    ],
    "additionalProperties": false
  },
  "protected_inputs": {},
  "license_id": "MIT",
  "data_egress": false,
  "when_to_use": [
    "Need an explicit check of sequence, structure or alignment input."
  ],
  "when_not_to_use": [
    "Need a calibrated phenotype prediction."
  ],
  "cost_hint": "One tool call; local CPU validation/geometry, no experimental query.",
  "output_semantics": "",
  "result_schema_version": "2",
  "validation_level": "contract_tested; deployment inference verification is separate",
  "examples": [
    {
      "purpose": "Need an explicit check of sequence, structure or alignment input.",
      "illustrative_only": true,
      "note": "Use actual campaign sequences and registered artifact references; this is not a scientific result.",
      "see_also": "docs/TOOL_CONTRACTS.md"
    }
  ]
}
