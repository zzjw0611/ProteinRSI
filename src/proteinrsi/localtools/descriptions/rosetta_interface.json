{
  "name": "rosetta_interface",
  "capability": "interface.energy",
  "description": "Optional licensed PyRosetta interface analysis for exactly two explicitly identified chains.",
  "limitations": "dG is in Rosetta energy units; not measured or calibrated Kd.",
  "engine": "pyrosetta",
  "task_kinds": [
    "binder_design",
    "affinity_prediction"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "structure_ref": {
        "type": "string",
        "pattern": "^artifact:[0-9a-f]{64}\\.(pdb|cif|a3m|fasta|json)$"
      },
      "target_chain": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]$"
      },
      "design_chain": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]$"
      },
      "seed": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      }
    },
    "required": [
      "structure_ref",
      "target_chain",
      "design_chain",
      "seed"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "evidence_kind"
    ]
  },
  "protected_inputs": {},
  "license_id": "SEE_THIRD_PARTY.md",
  "data_egress": false
}
