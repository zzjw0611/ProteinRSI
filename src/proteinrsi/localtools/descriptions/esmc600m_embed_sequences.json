{
  "name": "esmc600m_embed_sequences",
  "capability": "sequence.embed",
  "description": "ESMC-600M final-layer residue-mean embeddings; returns a local artifact reference, not the large tensor in the prompt.",
  "limitations": "",
  "engine": "esmc600m",
  "task_kinds": [
    "variant_design",
    "variant_ranking",
    "binder_design"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "sequences": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"
        },
        "minItems": 1,
        "maxItems": 384
      }
    },
    "required": [
      "sequences"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "model",
      "evidence_kind"
    ]
  },
  "protected_inputs": {},
  "license_id": "SEE_THIRD_PARTY.md",
  "data_egress": false
}
