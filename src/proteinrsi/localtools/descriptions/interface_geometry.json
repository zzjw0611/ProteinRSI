{
  "name": "interface_geometry",
  "capability": "interface.geometry",
  "description": "Compute inter-chain CA contact counts and distances; not affinity or all-atom energy.",
  "limitations": "",
  "engine": "utilities",
  "task_kinds": [
    "variant_design",
    "variant_ranking",
    "binder_design",
    "affinity_prediction"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "structure_ref": {
        "type": "string",
        "pattern": "^artifact:[0-9a-f]{64}\\.(pdb|cif|a3m|fasta|json)$"
      },
      "chain_a": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]$"
      },
      "chain_b": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]$"
      },
      "cutoff_angstrom": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 20
      }
    },
    "required": [
      "structure_ref",
      "chain_a",
      "chain_b",
      "cutoff_angstrom"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "evidence_kind"
    ]
  },
  "protected_inputs": {},
  "license_id": "MIT",
  "data_egress": false
}
