{
  "name": "interface_geometry",
  "capability": "interface.geometry",
  "description": "Compute inter-chain CA contact counts and distances; not affinity or all-atom energy.",
  "limitations": "",
  "engine": "utilities",
  "task_kinds": [
    "variant_design",
    "variant_ranking",
    "binder_design",
    "affinity_prediction"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "structure_ref": {
        "type": "string",
        "pattern": "^artifact:[0-9a-f]{64}\\.(pdb|cif|a3m|fasta|json)$"
      },
      "chain_a": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]$"
      },
      "chain_b": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]$"
      },
      "cutoff_angstrom": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 20
      }
    },
    "required": [
      "structure_ref",
      "chain_a",
      "chain_b",
      "cutoff_angstrom"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "evidence_kind": {
        "type": "string"
      },
      "warning": {
        "type": "string"
      },
      "ca_contact_pairs": {
        "type": "integer",
        "minimum": 0
      },
      "minimum_ca_distance_angstrom": {
        "type": "number"
      },
      "cutoff_angstrom": {
        "type": "number"
      }
    },
    "required": [
      "evidence_kind",
      "ca_contact_pairs",
      "minimum_ca_distance_angstrom",
      "cutoff_angstrom",
      "warning"
    ],
    "additionalProperties": false
  },
  "protected_inputs": {},
  "license_id": "MIT",
  "data_egress": false,
  "when_to_use": [
    "Need an explicit check of sequence, structure or alignment input."
  ],
  "when_not_to_use": [
    "Need a calibrated phenotype prediction."
  ],
  "cost_hint": "One tool call; local CPU validation/geometry, no experimental query.",
  "output_semantics": "",
  "result_schema_version": "2",
  "validation_level": "contract_tested; deployment inference verification is separate",
  "examples": [
    {
      "purpose": "Need an explicit check of sequence, structure or alignment input.",
      "illustrative_only": true,
      "note": "Use actual campaign sequences and registered artifact references; this is not a scientific result.",
      "see_also": "docs/TOOL_CONTRACTS.md"
    }
  ]
}
