{
  "name": "rosetta_relax",
  "capability": "structure.relax",
  "description": "Optional licensed PyRosetta restrained FastRelax. Preserves sequence identity.",
  "limitations": "Operator-installed licensed PyRosetta required; energies in REU, not affinity.",
  "engine": "pyrosetta",
  "task_kinds": [
    "variant_design",
    "variant_ranking",
    "binder_design",
    "affinity_prediction"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "structure_ref": {
        "type": "string",
        "pattern": "^artifact:[0-9a-f]{64}\\.(pdb|cif|a3m|fasta|json)$"
      },
      "repeats": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "seed": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      }
    },
    "required": [
      "structure_ref",
      "repeats",
      "seed"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "evidence_kind"
    ]
  },
  "protected_inputs": {},
  "license_id": "SEE_THIRD_PARTY.md",
  "data_egress": false
}
