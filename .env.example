# Optional: only used with --agent llm. Never commit real credentials.
PROTEINRSI_MODEL=YOUR_MODEL_ID
PROTEINRSI_BASE_URL=https://YOUR_PROVIDER/v1
PROTEINRSI_API_KEY=REPLACE_LOCALLY
# Protocol: chat_completions (default) or responses.
PROTEINRSI_API_PROTOCOL=chat_completions
# Optional reasoning effort; use medium for the configured Codex model.
# PROTEINRSI_REASONING_EFFORT=medium
# Reuse a local Codex API-key auth file instead of setting PROTEINRSI_API_KEY.
# PROTEINRSI_CODEX_AUTH_FILE=/absolute/path/to/auth.json
# Explicit opt-in only for an operator-selected HTTP provider.
# PROTEINRSI_ALLOW_HTTP=true
# PROTEINRSI_LLM_TIMEOUT=180
# Larger output allowance for large design/ranking batches (provider limits still apply).
# PROTEINRSI_LLM_MAX_OUTPUT_TOKENS=32768
# Total attempts per identical request, including the first; persists across resumes (1-10).
# PROTEINRSI_LLM_MAX_ATTEMPTS=4
# Optional Virtual Lab integration uses its own provider configuration.
# OPENAI_API_KEY=REPLACE_LOCALLY
# ESMC-600M is NOT a Chat Completions model. Configure it using
# examples/esmc600m.json / init --protein-config / init --device instead.
# Optional HF cache location for the explicit esmc-check --download command:
# HF_HOME=/your/model-cache
# Optional only when Hugging Face access requires authentication:
# HF_TOKEN=REPLACE_LOCALLY
